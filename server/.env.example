# MongoDB connection string
DB_URI=
# Secret used to sign JWTs (long random string)
JWT_SECRET=
# HTTP port for the API (defaults to 3000)
PORT=
# SMTP credentials for outgoing mail (server/helpers/email.js)
SMTP_USER=
SMTP_PASS=
# Web push (server/helpers/notifications.js): VAPID keys and contact subject (mailto: or https: URL)
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=
VAPID_SUBJECT=
